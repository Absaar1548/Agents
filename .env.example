# Copy to .env and fill in real values.

# --- LLM Provider ---
# Set to 'azure' (default) or 'ollama' for local development.
LLM_PROVIDER=azure

# --- Azure OpenAI (required when LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=https://your-endpoint.services.ai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Ollama (use when LLM_PROVIDER=ollama) ---
# Ollama exposes an OpenAI-compatible endpoint at /v1/chat/completions.
# Use any model you have pulled locally.  json_object support varies by model.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# --- OpenTelemetry / Phoenix ---
# Phoenix listens on 6006 for OTLP/HTTP. Already running on this host at plan time.
# If you need to launch Phoenix yourself, use:  phoenix serve --grpc-port 4347
# (4317 and 4327 are bound by stale processes in this env)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=brd-agent

# --- Neo4j (Phase 4 KG) ---
# Container managed by infra/docker-compose.yml — run.sh brings it up.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brd_agent_neo4j_pw
